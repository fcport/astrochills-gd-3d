radius = 2.5
height = 0.15

[sub_resource type="BoxMesh" id="BoxWall"]
size = Vector3(1.9134, 4.5, 0.15)
subdivide_width = 4
subdivide_height = 9
subdivide_depth = 1

[sub_resource type="BoxShape3D" id="ShapeWall"]
size = Vector3(1.9134, 4.5, 0.15)

[sub_resource type="BoxMesh" id="BoxRoof"]
size = Vector3(5.2, 0.15, 2.1)
subdivide_width = 10
subdivide_height = 1
subdivide_depth = 4

[sub_resource type="BoxShape3D" id="ShapeRoof"]
size = Vector3(5.2, 0.15, 2.1)

[sub_resource type="CylinderMesh" id="CylScopeTube"]
top_radius = 0.11
bottom_radius = 0.11
height = 1.0
radial_segments = 8

[sub_resource type="BoxMesh" id="BoxScopeLeg"]
size = Vector3(0.06, 1.3, 0.06)

; Il volume di collisione del telescopio (DW-12): un cilindro attorno alla colonna
; centrale. Il tubo ruota, ma la sua massa resta al mount, quindi un collider statico
; centrale basta a fermare il giocatore. Raggio 0,35 m (abbraccia treppiede + tubo alla
; fascia dello sguardo), alto 1,75 m — dal pavimento fino a sopra il tubo. Quota/raggio
; si tarano guardando (verifica d'operatore).
[sub_resource type="CylinderShape3D" id="ShapeScopeBody"]
radius = 0.35
height = 1.75

; Il volume di rilevamento di `DomeActivity`: un cilindro dentro la pianta ottagonale
; (circumraggio 2,5, apotema 2,31). Raggio 2,2 m, alto 2,0 m, centro y ~1,0: copre la
; zona dove si sta a guardare senza toccare le pareti. Si tara guardando/misurando.
[sub_resource type="CylinderShape3D" id="ShapeActivity"]
radius = 2.2
height = 2.0

