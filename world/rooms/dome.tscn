; Il telescopio segnaposto al centro: tubo inclinato verso la fessura, su treppiede.
; Dalla 3.5 e' vivo (telescope.gd): il tubo insegue durante l'imaging, la montatura
; ronza, e il `Body` gli da' fisicita' (DW-12). Non e' un interagibile.
[node name="Telescope" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
script = ExtResource("2_scope")

[node name="Tube" type="MeshInstance3D" parent="Telescope"]
transform = Transform3D(1, 0, 0, 0, 0.7071, -0.7071, 0, 0.7071, 0.7071, 0, 1.35, 0)
material_override = SubResource("MatScope")
mesh = SubResource("CylScopeTube")

; Il ronzio posizionale della montatura: suona SOLO mentre l'imaging espone (telescope.gd
; lo avvia/ferma sul bus). Presso il mount, cosi' allontanandosi si attenua — segno che
; appartiene al luogo, non alla fase. Stream sintetizzato in codice (segnaposto).
[node name="Hum" type="AudioStreamPlayer3D" parent="Telescope"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.0, 0)

; La fisicita' del telescopio (DW-12): StaticBody3D su LAYER_WORLD attorno alla colonna
; centrale, cosi' il giocatore non ci cammina dentro. La 3.1 lo aveva lasciato senza
; collisione. Cilindro centrato a y = 0,875 (base a terra, alto 1,75). Quota/raggio si
; tarano guardando.
[node name="Body" type="StaticBody3D" parent="Telescope"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.875, 0)
collision_layer = 1
collision_mask = 0

[node name="Collision" type="CollisionShape3D" parent="Telescope/Body"]
shape = SubResource("ShapeScopeBody")

[node name="LegA" type="MeshInstance3D" parent="Telescope"]
transform = Transform3D(1, 0, 0, 0, 0.966, 0.259, 0, -0.259, 0.966, 0.25, 0.65, 0.15)
material_override = SubResource("MatScope")
mesh = SubResource("BoxScopeLeg")

[node name="LegB" type="MeshInstance3D" parent="Telescope"]
transform = Transform3D(1, 0, 0, 0, 0.966, 0.259, 0, -0.259, 0.966, -0.25, 0.65, 0.15)
material_override = SubResource("MatScope")
mesh = SubResource("BoxScopeLeg")

[node name="LegC" type="MeshInstance3D" parent="Telescope"]
transform = Transform3D(1, 0, 0, 0, 0.966, -0.259, 0, 0.259, 0.966, 0, 0.65, -0.28)
material_override = SubResource("MatScope")
mesh = SubResource("BoxScopeLeg")

; Fill fioco freddo: senza sorgente le pareti a luce per-vertice sarebbero nere.
; La fessura lascia entrare il cielo, non luce da illuminare la stanza.
[node name="Fill" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.2, 0)
light_color = Color(0.6, 0.68, 0.85, 1)
light_energy = 0.7
omni_range = 6.0

; L'attivita' «stare a guardare» (dome_activity.gd): Area3D al centro cupola che rileva il
; giocatore e misura la permanenza con la posa in corso, emettendo la coppia
; wait_activity_*(&"cupola") verso la telemetria (3.6). Nessun feedback visibile. Il
; collider cilindrico (raggio 2,2, alto 2,0, centro y = 1,0) sta dentro la pianta
; ottagonale. Rileva SOLO il giocatore (mask LAYER_PLAYER), non e' trovabile da nessuno
; (layer 0): dome_activity.gd li fissa in `_ready`.
[node name="DomeActivity" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.0, 0)
script = ExtResource("3_activity")

[node name="Collision" type="CollisionShape3D" parent="DomeActivity"]
shape = SubResource("ShapeActivity")

; La soglia di permanenza (dome_activity.gd fissa one_shot e wait_time dal codice: e' un
; valore di rituale, non di layout — stessa scelta del BrewTimer della moka).
[node name="Dwell" type="Timer" parent="DomeActivity"]

; Il cigolio ambientale della cupola: posizionale, appartiene al posto e NON alla
; sequenza (a differenza del ronzio della montatura). Stream sintetizzato in codice.
[node name="Creak" type="AudioStreamPlayer3D" parent="DomeActivity"]
