; Tetto in due lastre: lasciano una fessura (z ∈ [−0,5, +0,5]) aperta sul cielo.
[node name="RoofNorth" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 4.5, 1.55)
collision_mask = 0

[node name="Mesh" type="MeshInstance3D" parent="RoofNorth"]
