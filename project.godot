[layer_names]

3d_physics/layer_1="mondo"
3d_physics/layer_2="giocatore"
3d_physics/layer_3="interagibili"

[rendering]

textures/canvas_textures/default_texture_filter=0
# FORWARD+ E NON PIU' gl_compatibility, e non e' una scelta di gusto: e' il
# vincolo che rendeva impossibile la cosa chiesta. In OpenGL Compatibility le
# luci puntiformi con ombra sono poche e si ESCLUDONO A VICENDA - accendendo la
# luce rossa della cupola si spegnevano quelle della sala divulgazione, che
# restavano accese a vedersi e non illuminavano piu' niente. Nessuna manopola lo
# risolve: max_lights_per_object era gia' al massimo e l'atlante a 8192.
#
# Forward+ raggruppa le luci in cluster e non ha quel tetto; in piu' le sue mappe
# d'ombra tolgono la griglia di linee sul soffitto. Il costo e' hardware un po'
# meno vecchio, che qui c'e'. Si torna indietro cambiando questa riga.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
#OTTOLUCIPEROGGETTONONBASTANO.InOpenGLCompatibilityognisuperficiene#consideraalmassimootto,eleplafonieresonodieci:sulpavimentodell'alaest,#chee'unpezzosolo,ledueineccessovenivanoscartateinsilenzio-lalampada#sivedevaaccesaesottononarrivavaniente.Dodici,chee'sottoiltettodi#quindicielasciamargineperlelucidiscena.rendering/limits/opengl/max_lights_per_object=15
# ATLANTE DELLE OMBRE PIU' GRANDE. Dodici luci con ombra in un atlante da 4096 si
# dividono qualche centinaio di pixel a testa, e una shadow map troppo grossa per
# la superficie che copre si vede come una GRIGLIA DI LINEE sul soffitto - non e'
# la trama dell'intonaco, e' la mappa d'ombra che si campiona da sola.
rendering/lights_and_shadows/positional_shadow/atlas_size=8192
