[gd_resource type="Resource" script_class="TargetData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/targets/target_data.gd" id="1_target"]

[resource]
script = ExtResource("1_target")
id = &"m13"
short = "M13"
full = "Ammasso di Ercole"
type = &"GLOB"
diff = 1
min_exp = 20
vis_from = "23:00"
vis_to = "06:00"
desc = "Uno degli ammassi globulari più belli del cielo, a 22.000 anni-luce. Contiene oltre 300.000 stelle compresse in una sfera di 145 anni-luce. Nel 1974 il radiotelescopio di Arecibo ci puntò il primo messaggio radio diretto a civiltà aliene."
