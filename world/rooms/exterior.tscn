; L'esterno: il prato intorno all'edificio, la sterrata che si allontana, e il
; BOSCO PERIMETRALE ad anello che e' il confine del mondo. Kit-bash con lo stesso
; pattern del resto — mesh box/cylinder suddivise per la luce per-vertice di
; ps1.gdshader, ShaderMaterial ps1 CONDIVISI, `material_override` MAI
; `surface_material_override/0`. Segnaposto fino al pack di texture (prato, sterrata
; e alberi sono materiale grezzo: arriveranno le texture, non rifinirli).
;
; NESSUN MURO INVISIBILE. Il confine e' il bosco: un anello di tronchi con
; collisione a r ≈ 13 m dal centro dell'edificio. Ci si allontana quanto basta a
; voltarsi e guardare l'edificio, non di piu' — «non ti allontani mai dall'edificio»
; (brief). I tronchi si toccano abbastanza da fermare la capsula (raggio 0,3) senza
; lasciarla passare, e da fuori sono una parete di bosco, non pali isolati.
;
; IL PRATO e' un piano ampio (40x40 m) leggermente sotto lo zero, cosi' che il
; pavimento delle stanze (y = 0, spesse lastre) resti appena sopra il terreno e
; non ci sia z-fighting con il prato. LA STERRATA e' una striscia di materiale
; diverso appoggiata sopra il prato, che parte dalla porta sud e si allontana verso
; il bosco: non porta da nessuna parte (non c'e' nient'altro), e' li' per dare al
; prato una direzione e una scala.
;
; IL GUSCIO ESTERNO dell'edificio in questa storia e' dato dalle pareti delle stanze
; stesse (sono lastre singole, visibili da entrambi i lati) piu' i TETTI qui sotto,
; che chiudono l'edificio visto da fuori sopra l'atrio e raccordano i volumi. Le
; stanze portano gia' il proprio soffitto; questi tetti sono il profilo dell'edificio
; contro il cielo, segnaposto come tutto il resto.
;
; L'ORIGINE della scena coincide con l'origine di observatory.tscn (centro della
; stanza computer): il prato e il bosco sono centrati sull'edificio.
[gd_scene load_steps=14 format=3]

[ext_resource type="Shader" path="res://world/shaders/ps1.gdshader" id="1_ps1"]

[sub_resource type="ShaderMaterial" id="MatGrass"]
shader = ExtResource("1_ps1")
shader_parameter/albedo = Color(0.12, 0.16, 0.12, 1)
shader_parameter/snap_resolution = 665.0

[sub_resource type="ShaderMaterial" id="MatDirt"]
shader = ExtResource("1_ps1")
shader_parameter/albedo = Color(0.22, 0.19, 0.14, 1)
shader_parameter/snap_resolution = 665.0

[sub_resource type="ShaderMaterial" id="MatTrunk"]
shader = ExtResource("1_ps1")
shader_parameter/albedo = Color(0.14, 0.13, 0.11, 1)
shader_parameter/snap_resolution = 665.0

[sub_resource type="ShaderMaterial" id="MatFoliage"]
shader = ExtResource("1_ps1")
shader_parameter/albedo = Color(0.08, 0.13, 0.09, 1)
shader_parameter/snap_resolution = 665.0

[sub_resource type="ShaderMaterial" id="MatRoof"]
shader = ExtResource("1_ps1")
shader_parameter/albedo = Color(0.24, 0.25, 0.27, 1)
shader_parameter/snap_resolution = 665.0

[sub_resource type="PlaneMesh" id="PlaneGrass"]
size = Vector2(40.0, 40.0)
subdivide_width = 20
subdivide_depth = 20

[sub_resource type="BoxShape3D" id="ShapeGround"]
size = Vector3(40.0, 0.2, 40.0)

[sub_resource type="BoxMesh" id="BoxPath"]
size = Vector3(2.0, 0.04, 11.0)
subdivide_width = 2
subdivide_depth = 11

[sub_resource type="CylinderMesh" id="CylTrunk"]
top_radius = 0.22
bottom_radius = 0.28
height = 5.0
radial_segments = 6

[sub_resource type="CylinderShape3D" id="ShapeTrunk"]
radius = 0.8
height = 5.0

[sub_resource type="BoxMesh" id="BoxRoof"]
size = Vector3(7.7, 0.3, 8.7)
subdivide_width = 8
subdivide_height = 1
subdivide_depth = 6

[sub_resource type="SphereMesh" id="SphereFoliage"]
radius = 1.3
height = 2.6
radial_segments = 6
rings = 4

[node name="Exterior" type="Node3D"]

; IL TERRENO: piano visibile (prato) + un corpo statico piatto che regge il
; giocatore ovunque fuori, cosi' non si cade nel vuoto uscendo dall'edificio. Il
; piano sta a y = −0,02 per non litigare con le lastre del pavimento delle stanze.
[node name="Ground" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.02, 0)
collision_mask = 0

[node name="Mesh" type="MeshInstance3D" parent="Ground"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
material_override = SubResource("MatGrass")
mesh = SubResource("PlaneGrass")

[node name="Collision" type="CollisionShape3D" parent="Ground"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.1, 0)
shape = SubResource("ShapeGround")

; LA STERRATA: parte dalla porta sud (a z ≈ +2,6, davanti all'atrio) e va verso
; sud fino al bosco. Appoggiata sopra il prato (y = +0,01) per restare visibile.
[node name="Path" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.5, 0.01, 8.0)
material_override = SubResource("MatDirt")
mesh = SubResource("BoxPath")

; I TETTI: profilo dell'edificio contro il cielo (le stanze hanno gia' il proprio
; soffitto). Segnaposto.
;
; ALLUNGATO A NORD IL 2026-08-24, insieme alla correzione della cucina: si fermava
; a z = -2,75 perche' la cucina era finita dentro la stanza computer e da fuori non
; c'era niente da coprire. Adesso la cucina sta davvero a nord (z fino a -5,80) e il
; tetto la segue: z∈[-5,95, 2,75], profondita' 8,7.
; Il tetto APPOGGIA sulle lastre di soffitto, non ci affonda dentro. y=3,10 con
; spessore 0,30 -> faccia inferiore a 2,95, che e' esattamente la faccia SUPERIORE dei
; soffitti (lastre 0,15 centrate a 2,875, da 2,80 a 2,95) e la cima dei muri (alti 2,8).
; ERA a 2,95: faccia inferiore a 2,80, cioe' COMPLANARE con la faccia inferiore dei
; soffitti. Due superfici nello stesso piano, e da dentro la stanza si vedeva la
; maculazione mobile dello z-fighting su tutto il soffitto — segnalata guardando, il
; 2026-08-24. Nessun controllo statico poteva vederla: i due file erano corretti
; ciascuno per conto suo, e il difetto viveva nella somma.
