[gd_resource type="Resource" script_class="TargetData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/targets/target_data.gd" id="1_target"]

[resource]
script = ExtResource("1_target")
id = &"m42"
short = "M42"
full = "Nebulosa di Orione"
type = &"NEB"
diff = 1
min_exp = 30
vis_from = "21:00"
vis_to = "04:00"
desc = "La regione di formazione stellare più vicina e luminosa del cielo, a 1.350 anni-luce. Si vede a occhio nudo come una \"stella\" sfocata nella spada di Orione. Al telescopio rivela strutture filamentose di idrogeno illuminate dalle giovani stelle del Trapezio."
