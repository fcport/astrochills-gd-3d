; La moka (D-244): una cosa che si prende in mano, si mette sul fuoco e versa il caffe'
; nelle tazze. Compare in cucina SOLO quando l'articolo &"moka" e' posseduto — comprato
; al terminale (3.2) — e tutto il resto sta in moka.gd.
;
; NON E' PIU' UN INTERAGIBILE FERMO. Era uno StaticBody3D con un timer: la si guardava e
; si premeva E. Adesso e' un corpo rigido come il termos e la tazza, e il caffe' lo fa il
; fuoco (`fornello.gd`).
;
; IL CORPO arriva da `assets/models/moka.glb`, che `tools/moka_blender.py` posa da un
; modello scaricato: una caffettiera conica di alluminio segnato, venti centimetri col
; pomello, CC-BY di "ninja of stealth" (il credito e' in `CREDITI.md` e in
; `assets/models/esterni/moka/FONTE.txt`). L'ORIGINE E' ALLA BASE, al centro in pianta:
; posata, la moka ha l'origine sul piano, ed e' il punto che il fornello guarda.
[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://world/interactables/moka.gd" id="1_moka"]
[ext_resource type="PackedScene" path="res://assets/models/moka.glb" id="2_modello"]

; IL COLLIDER RICALCA IL CORPO, NON L'INGOMBRO: 8,9 cm in pianta e 20 alto col pomello,
; misurati da `moka_blender.py`. Il manico e il becco restano fuori, come l'antenna della
; radiolina. UNA SCATOLA E NON UN CILINDRO, per la ragione della tazza (D-201): un
; cilindro appoggiato su una griglia trova contatti asimmetrici e gira su se stesso.
[sub_resource type="BoxShape3D" id="ShapeMoka"]
size = Vector3(0.089, 0.20, 0.089)

; Mezzo chilo: una moka d'alluminio da tre tazze, vuota.
[node name="Moka" type="RigidBody3D"]
mass = 0.5
script = ExtResource("1_moka")
nome = "la moka"

[node name="Modello" parent="." instance=ExtResource("2_modello")]

[node name="Col" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.100, 0)
shape = SubResource("ShapeMoka")
