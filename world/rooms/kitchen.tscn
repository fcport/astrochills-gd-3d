; La cucina, kit-bashata con lo stesso pattern della stanza computer (idea.md §14):
; mesh box suddivise perche' la luce di ps1.gdshader e' per-vertice, ShaderMaterial
; ps1 CONDIVISI fra superfici omogenee (una ritintura in un punto solo), ogni
; MeshInstance3D con `material_override` MAI `surface_material_override/0` — vedi
; l'intestazione di computer_room.tscn per il perche' di ognuna di queste scelte.
;
; SEGNAPOSTO fino al pack di texture: geometria grezza, nessuna rifinitura estetica.
;
; L'ORIGINE DELLA SCENA e' l'angolo sud-ovest interno della cucina, a terra: chi la
; colloca in observatory.tscn scrive la posizione del suo spigolo e non deve fare
; aritmetica sul centro. La cucina e' larga 3 m (x) x 3 m (z), pavimento y = 0,
; soffitto a 2,8 m come la stanza computer.
;
; APERTA SULL'ATRIO sul lato ovest (−x): non c'e' muro li', si entra a piedi dal
; corridoio senza porta. Le pareti chiuse sono nord, est e sud.
;
; IL REGISTRO «FARE» DELL'ATTESA VIVE QUI: la moka (storia 3.3) e' istanziata sul piano
; d'appoggio, e la lampada (3.4) arrivera'. La moka NASCE SPENTA e invisibile: compare
; solo quando l'articolo &"moka" e' posseduto (comprato al terminale, 3.2), leggendo
; `Game.profile.owns` all'avvio e ascoltando `Events.item_purchased` a runtime — tutto
; dentro moka.gd, senza passare da qui ne' da `main.gd`. Il posto c'era (questa cucina),
; ora c'e' l'oggetto.
[gd_scene load_steps=15 format=3]

[ext_resource type="Shader" path="res://world/shaders/ps1.gdshader" id="1_ps1"]
[ext_resource type="PackedScene" path="res://world/interactables/moka.tscn" id="2_moka"]

[sub_resource type="ShaderMaterial" id="MatFloor"]
shader = ExtResource("1_ps1")
shader_parameter/albedo = Color(0.22, 0.22, 0.21, 1)
shader_parameter/snap_resolution = 665.0

[sub_resource type="ShaderMaterial" id="MatCeiling"]
shader = ExtResource("1_ps1")
shader_parameter/albedo = Color(0.28, 0.3, 0.32, 1)
shader_parameter/snap_resolution = 665.0

[sub_resource type="ShaderMaterial" id="MatWall"]
shader = ExtResource("1_ps1")
shader_parameter/albedo = Color(0.4, 0.44, 0.43, 1)
shader_parameter/snap_resolution = 665.0

[sub_resource type="ShaderMaterial" id="MatCounter"]
shader = ExtResource("1_ps1")
shader_parameter/albedo = Color(0.34, 0.36, 0.38, 1)
shader_parameter/snap_resolution = 665.0

[sub_resource type="BoxMesh" id="BoxSlab"]
size = Vector3(3.0, 0.15, 3.0)
subdivide_width = 8
subdivide_height = 1
subdivide_depth = 8

[sub_resource type="BoxShape3D" id="ShapeSlab"]
size = Vector3(3.0, 0.15, 3.0)

[sub_resource type="BoxMesh" id="BoxWallNS"]
size = Vector3(3.0, 2.8, 0.15)
subdivide_width = 7
subdivide_height = 6
subdivide_depth = 1

[sub_resource type="BoxShape3D" id="ShapeWallNS"]
size = Vector3(3.0, 2.8, 0.15)

[sub_resource type="BoxMesh" id="BoxWallE"]
size = Vector3(0.15, 2.8, 3.0)
subdivide_width = 1
subdivide_height = 6
subdivide_depth = 7

[sub_resource type="BoxShape3D" id="ShapeWallE"]
size = Vector3(0.15, 2.8, 3.0)

[sub_resource type="BoxMesh" id="BoxCounter"]
size = Vector3(0.6, 0.9, 2.2)
subdivide_width = 1
subdivide_height = 2
subdivide_depth = 5

[sub_resource type="BoxShape3D" id="ShapeCounter"]
size = Vector3(0.6, 0.9, 2.2)

[node name="Kitchen" type="Node3D"]

[node name="Floor" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.5, -0.075, 1.5)
collision_mask = 0

[node name="Mesh" type="MeshInstance3D" parent="Floor"]
material_override = SubResource("MatFloor")
mesh = SubResource("BoxSlab")

[node name="Collision" type="CollisionShape3D" parent="Floor"]
shape = SubResource("ShapeSlab")

[node name="Ceiling" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.5, 2.875, 1.5)
collision_mask = 0

[node name="Mesh" type="MeshInstance3D" parent="Ceiling"]
material_override = SubResource("MatCeiling")
mesh = SubResource("BoxSlab")

[node name="Collision" type="CollisionShape3D" parent="Ceiling"]
shape = SubResource("ShapeSlab")

[node name="WallNorth" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.5, 1.4, 3.075)
collision_mask = 0

[node name="Mesh" type="MeshInstance3D" parent="WallNorth"]
material_override = SubResource("MatWall")
mesh = SubResource("BoxWallNS")

[node name="Collision" type="CollisionShape3D" parent="WallNorth"]
shape = SubResource("ShapeWallNS")

[node name="WallSouth" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.5, 1.4, -0.075)
collision_mask = 0

[node name="Mesh" type="MeshInstance3D" parent="WallSouth"]
material_override = SubResource("MatWall")
mesh = SubResource("BoxWallNS")

[node name="Collision" type="CollisionShape3D" parent="WallSouth"]
shape = SubResource("ShapeWallNS")

[node name="WallEast" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.075, 1.4, 1.5)
collision_mask = 0

[node name="Mesh" type="MeshInstance3D" parent="WallEast"]
material_override = SubResource("MatWall")
mesh = SubResource("BoxWallE")

[node name="Collision" type="CollisionShape3D" parent="WallEast"]
shape = SubResource("ShapeWallE")

; Il piano d'appoggio segnaposto sotto la parete est: 90 cm, l'altezza da cucina, top a
; y = 0,9. Ci sta sopra la moka (3.3), e ci stara' la lampada (3.4). Qui e' solo il
; mobile — l'oggetto e' l'istanza Moka piu' sotto.
[node name="Counter" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.7, 0.45, 1.5)
collision_mask = 0

[node name="Mesh" type="MeshInstance3D" parent="Counter"]
material_override = SubResource("MatCounter")
mesh = SubResource("BoxCounter")

[node name="Collision" type="CollisionShape3D" parent="Counter"]
shape = SubResource("ShapeCounter")

; Una luce fredda fioca: la cucina non ha una lampada accesa (quella e' la 3.4),
; ma senza una sorgente le pareti a luce per-vertice resterebbero nere. Fill, non
; key: la key della stanza e' altrove, e la nebbia dell'Environment fa il resto.
[node name="Fill" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.5, 2.5, 1.5)
light_color = Color(0.7, 0.78, 0.9, 1)
light_energy = 0.9
omni_range = 5.0

; La moka sul piano d'appoggio, verso il bordo ovest (il lato da cui si entra): origine a
; (2,5, 0,9, 1,5) — sul top del Counter (y = 0,9), un filo dentro dal bordo ovest del
; piano (Counter a x = 2,7, largo 0,6 → bordo ovest a x = 2,4). Nasce spenta/invisibile:
; moka.gd la accende sul possesso. La raggiungibilita' dal davanti al piano si tara
; guardando (verifica d'operatore).
[node name="Moka" parent="." instance=ExtResource("2_moka")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.5, 0.9, 1.5)
